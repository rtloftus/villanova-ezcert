{
  "name": "grad-cert-app",
  "productName": "grad-cert-app",
  "version": "1.0.0",
  "description": "My Electron application description",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "echo \"No linting configured\"",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win"
  },
"build": {
  "appId": "com.villanova.ezcert",
  "productName": "Villanova EzCert",
  "npmRebuild": false,

  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "src/icon.ico"
  },

  "mac": {
    "target": "dmg",
    "icon": "src/icon.icns"
  },

  "nsis": {
    "oneClick": true,
    "allowToChangeInstallationDirectory": false
  }
},
  "keywords": [],
  "author": {
    "name": "rtloftus",
    "email": "152215889+rtloftus@users.noreply.github.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "^4.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "43.0.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.1.3"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "electron-squirrel-startup": "^1.0.1",
    "fast-xml-parser": "^5.9.3",
    "pdf-parse": "^1.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0"
  }
}
